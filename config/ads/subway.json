      },
      "color": [220, 240, 255]
    },
    {
      "rule_id": "PERSONAL_RECOMM",
      "priority": 30,
      "message": "🥗 튀기지 않은 재료로 가벼운 한 끼 추천",
      "conditions": { "type": "array_contains", "user_field": "attributes", "value": "health" },
      "color": [220, 255, 220]
    },
    {
      "rule_id": "PERSONAL_RECOMM",
      "priority": 30,
      "message": "💪 단백질 16.5g! 운동 후 샌드위치 추천",
      "conditions": { "type": "array_contains", "user_field": "attributes", "value": "protein" },
      "color": [220, 230, 255]
